<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================
         PARENT: Spring Boot BOM manages all dependency versions.
         Using a fixed version ensures reproducible builds across
         all environments (dev, staging, prod) — a must for teams.
    ============================================================ -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/>
    </parent>

    <groupId>com.production</groupId>
    <artifactId>springboot-production</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>springboot-production</name>
    <description>Production-grade Spring Boot application demonstrating JPA/Hibernate, DTO, DAO, REST APIs</description>

    <properties>
        <java.version>17</java.version>
        <!-- Java 17 LTS is the standard for Amazon/Netflix-scale production apps -->
        <lombok.version>1.18.30</lombok.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <flyway.version>9.22.3</flyway.version>
    </properties>

    <dependencies>

        <!-- ============================================================
             CORE WEB: Embeds Tomcat, configures DispatcherServlet,
             Jackson (JSON), and all MVC infrastructure automatically.
        ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ============================================================
             JPA / HIBERNATE: Spring Data JPA wraps Hibernate (the default
             JPA provider). Switching the persistence strategy is done
             via profiles — detailed in application.properties.
        ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ============================================================
             VALIDATION: Bean Validation (JSR-380) via Hibernate Validator.
             Powers @Valid, @NotBlank, @Size, etc. on DTO fields.
             Production requirement — never trust incoming data.
        ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ============================================================
             ACTUATOR: Exposes /actuator/health, /actuator/metrics, etc.
             Netflix/Amazon use this for load-balancer health checks and
             Prometheus scraping. Secured via properties in production.
        ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ============================================================
             MYSQL DRIVER: Runtime-scoped — only needed when the app runs.
             Use the official Connector/J driver (thread-safe, supports
             connection pooling via HikariCP, which is auto-configured).
        ============================================================ -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================================================
             FLYWAY: Database migration tool. Tracks schema changes in
             versioned SQL scripts (V1__init.sql, V2__add_index.sql…).
             Critical for CI/CD pipelines — zero manual SQL on deploy.
        ============================================================ -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- ============================================================
             MAPSTRUCT: Compile-time DTO ↔ Entity mapper (zero reflection).
             Far faster than ModelMapper at scale. Used by Amazon-style
             services where mapping runs millions of times per day.
        ============================================================ -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- ============================================================
             LOMBOK: Reduces boilerplate (@Getter, @Builder, @Slf4j…).
             Must come before MapStruct in annotation processing order
             (configured in the build section below).
        ============================================================ -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ============================================================
             H2: In-memory DB for running tests without MySQL.
             Scope=test means it never ships to production.
        ============================================================ -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- TEST STACK: JUnit 5 + Mockito + Spring Test (MockMvc) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- ============================================================
                 COMPILER: Annotation processors must be declared explicitly
                 to ensure Lombok runs BEFORE MapStruct. Wrong order causes
                 MapStruct to miss Lombok-generated methods (getters/setters).
            ============================================================ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <!-- Lombok FIRST -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <!-- MapStruct SECOND (sees Lombok-generated code) -->
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <!-- Tells MapStruct to use Spring's IoC for mapper injection -->
                        <arg>-Amapstruct.defaultComponentModel=spring</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- ============================================================
                 SPRING BOOT MAVEN PLUGIN: Packages as an executable fat-JAR.
                 'mvn spring-boot:run' used in dev; fat-JAR deployed to prod.
                 Excludes Lombok from the final artifact (compile-time only).
            ============================================================ -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
